# ── Chikwafu API ───────────────────────────────────────────────────────
# cp .env.example .env  and adjust as needed.

# MongoDB connection string.
# Local install:   mongodb://127.0.0.1:27017/chikwafu
# Atlas:           mongodb+srv://USER:PASS@cluster.mongodb.net/chikwafu
MONGO_URI=mongodb://127.0.0.1:27017/chikwafu

# Secret used to sign JWTs. CHANGE THIS before deploying anywhere public —
# anyone who knows it can mint an admin token.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Port the API listens on.
PORT=5000

# Allowed CORS origins. These must match where the two front ends run,
# otherwise the browser will block every request.
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

NODE_ENV=development
