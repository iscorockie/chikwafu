# ───────────────────────── Storefront (Vite) ─────────────────────────
# Point the storefront at the Chikwafu API. Build-time only — Vite inlines
# VITE_* variables into the bundle, so set this in your host's dashboard
# (GitHub Pages: repository secret VITE_API_URL, see .github/workflows/deploy.yml).
# LEAVE UNSET when:
#   · `npm run dev:all` / `npm run server` — the app auto-detects the
#     same-origin API (Vite proxies /api to :5000 in dev),
#   · the static Pages build with no API deployed — the app stays in demo mode.
# VITE_API_URL=https://chikwafu-api.onrender.com

# ───────────────────────── API server (/server) ─────────────────────────
# Port the Express API (and the built storefront) listens on.
PORT=5000
# HOST=0.0.0.0
# Base URL used when building absolute upload URLs (defaults to the request host).
# PUBLIC_URL=https://api.example.com
# Where the storefront is published — used for links in outgoing email.
# STORE_URL=https://iscorockie.github.io/chikwafu

# Staff account seeded on first boot (bcrypt-hashed into the store).
ADMIN_EMAIL=admin@chikwafu.ug
ADMIN_PASSWORD=chikwafu2026
ADMIN_NAME=Chikwafu Admin

# Signing secret for staff JWTs. MANDATORY in production: serverless hosts have
# no disk to persist a generated secret to, so every deploy would sign staff out.
# JWT_SECRET=change-me
# JWT_EXPIRES_IN=8h

# ─── Persistence ───────────────────────────────────────────────────────────
# Unset → server/data/db.json (local dev, single node, zero configuration).
# Set   → any managed Postgres (Neon by default). Apply supabase/schema.sql first:
#           psql "$DATABASE_URL" -f supabase/schema.sql
# Neon: Dashboard → project → Connection details (the pooled -pooler string is fine).
# DATABASE_URL=postgres://user:pass@ep-<id>-pooler.<region>.aws.neon.tech/neondb
# PG_SSL=true   # optional: auto-detected for neon/railway/render/supabase hosts
# PG_POOL_MAX=5
# Seed the 34-order demo ledger into a fresh Postgres database (off by default).
# SEED_DEMO_LEDGER=false

# ─── Supabase Storage (staff product photos) — OPTIONAL add-on ─────────────
# Not required: without these, uploads live in UPLOAD_DIR and are served from
# /uploads/*. Set both and uploads go to the `media` bucket instead — useful on
# any host without a writable disk.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_KEY=            # service_role key — never the anon key
# SUPABASE_BUCKET=media

# ─── Mobile money ──────────────────────────────────────────────────────────
# `sandbox` simulates prompts (a phone ending in 0000 declines). `live`
# requires a key and real integration code in server/routes/payments.mjs.
ZENGAPAY_MODE=sandbox
# ZENGAPAY_API_KEY=

# ─── Zoho ──────────────────────────────────────────────────────────────────
# Each block is independent and stays inert until its key is present, so you
# can adopt them one at a time. A Zoho outage never fails an order.
#
# ZeptoMail — order receipts + status emails (transactional only).
# Verify the sending domain first: SPF + DKIM records in your DNS.
# ZEPTOMAIL_API_KEY=
# ZEPTOMAIL_FROM=orders@chikwafu.ug
# ZEPTOMAIL_FROM_NAME=Chikwafu Appliances
#
# Campaigns — forwards newsletter sign-ups to a mailing list.
# Needs a self-client OAuth token (the API rejects static keys) + a list key.
# ZOHO_CAMPAIGNS_TOKEN=
# ZOHO_CAMPAIGNS_LIST_KEY=
#
# Desk — files a ticket when the Agent delivers an order the Admin missed.
# ZOHO_DESK_TOKEN=
# ZOHO_DESK_ORG_ID=
#
# Data-centre region for campaigns/desk/zeptomail hosts:
# com (default) · eu · in · com.au · com.cn · ca · jp · sa
# ZOHO_REGION=com

# Set to false to run the API without hosting dist/ (e.g. behind a proxy).
# SERVE_STATIC=true

# Browser origins allowed to call this API from another host — comma-separated.
# Unset keeps the development default (`*`); set it to the storefront in
# production. A full site URL is reduced to its origin automatically, since a
# browser's Origin header never carries a path.
# Alternatively proxy /api through the storefront's own rewrites (vercel.json
# does) so requests are same-origin and need no CORS at all.
# CORS_ORIGINS=https://chikwafu.vercel.app,https://iscorockie.github.io/chikwafu/
