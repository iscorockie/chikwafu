# ───────────────────────── Storefront (Vite) ─────────────────────────
# Point the admin dashboard + checkout at a cross-origin Chikwafu API.
# LEAVE UNSET for the usual setups:
#   · `npm run dev:all` / `npm run server` — the app auto-detects the
#     same-origin API (Vite proxies /api to :5000 in dev),
#   · GitHub Pages — no API answers, so the app stays in demo mode.
# VITE_API_URL=https://api.example.com

# ───────────────────────── API server (/server) ─────────────────────────
# Port the Express API (and the built storefront) listens on.
PORT=5000
# HOST=0.0.0.0
# Base URL used when building absolute upload URLs (defaults to the request host).
# PUBLIC_URL=https://api.example.com

# Staff account seeded on first boot (bcrypt-hashed into server/data/db.json).
ADMIN_EMAIL=admin@chikwafu.ug
ADMIN_PASSWORD=chikwafu2026
ADMIN_NAME=Chikwafu Admin

# Signing secret for staff JWTs. Unset = a random secret is generated and
# persisted to server/data/.jwt-secret on first boot.
# JWT_SECRET=change-me
# JWT_EXPIRES_IN=8h

# Mobile-money gateway. `sandbox` simulates prompts (a phone ending in 0000
# declines). `live` requires a key and real integration code in
# server/routes/payments.mjs.
ZENGAPAY_MODE=sandbox
# ZENGAPAY_API_KEY=

# Set to false to run the API without hosting dist/ (e.g. behind a proxy).
# SERVE_STATIC=true
